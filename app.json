{
  "expo": {
    "name": "Annual Dinner",
    "slug": "2027AnnualDinner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "2027AnnualDinner",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon_small.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f2744"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan employee QR codes for Annual Dinner check-in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f2744",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.x2027AnnualDinner",
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Annual Dinner to use the camera for QR check-in."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f2744",
          "image": "./assets/icon_small.png",
          "imageWidth": 120
        }
      ]
    ],
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    }
  }
}
